# Next.js Customer Website (never expose these variables in NEXT_PUBLIC_ variables)
# Local only: use a random 32+ character shared secret matching Django
PORTAL_BACKEND_URL=http://127.0.0.1:8000
PORTAL_PROXY_SHARED_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Vercel production environment:
# CUBEGEARS_BACKEND_URL=https://your-django-server.example.com
# PORTAL_PROXY_SHARED_SECRET=<same value as Django>

# On Django (DEBUG local only): PORTAL_DEV_COMPANY_SLUG=<existing workshop slug>
# On Django (production): CUSTOMER_PORTAL_ROOT_DOMAIN=<verified platform root domain>
# On Django: CUSTOMER_WEBSITE_LINKS_ENABLED=true once wildcard SSL and DNS work
