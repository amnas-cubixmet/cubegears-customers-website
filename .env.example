# Development only. Copy this file to .env.local.
# Match PORTAL_PROXY_SHARED_SECRET on Django exactly; generate your own random secret.
PORTAL_BACKEND_URL=http://127.0.0.1:8000
PORTAL_PROXY_SHARED_SECRET=

# Production Vercel project -> Settings -> Environment Variables (server-side only):
# CUBEGEARS_BACKEND_URL=https://api.cubixgear.tech
# PORTAL_PROXY_SHARED_SECRET=<SAME_SECRET_AS_DJANGO_AT_LEAST_32_CHARACTERS>
# CUSTOMER_PORTAL_ROOT_DOMAIN=customer.cubixgear.tech
# Do NOT prefix these keys with NEXT_PUBLIC_. Do NOT upload populated .env.local.

# Match CUSTOMER_PORTAL_ROOT_DOMAIN in Django; platform wildcard only.
CUSTOMER_PORTAL_ROOT_DOMAIN=customer.cubixgear.tech

# For a private Next.js listener behind a reverse proxy that overwrites X-Real-IP.
# PORTAL_TRUST_PROXY_CLIENT_IP=true
